# Supabase project URL (Settings → API).
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key (sb_publishable_…), never the legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase service-role key: server-only, for movie-cache writes (lib/supabase/admin.ts) and `pnpm seed`. Set it on Vercel (Production and Preview), never with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
# TMDB v4 API read access token, sent as a bearer token.
TMDB_READ_TOKEN=
# Anthropic API key for the taste profile.
ANTHROPIC_API_KEY=
# Model id passed to the AI SDK Anthropic provider.
AI_MODEL=claude-sonnet-5
